    // Named workspaces, always first and in this order, so Mod+1-5 reach them.
    workspace "1"
    workspace "2"
    workspace "3"
    workspace "4"
    workspace "5"

    // Rules only choose where a window opens; it can still be moved afterward.
    window-rule {
        match app-id="^helium$"
        open-on-workspace "1"
    }

    window-rule {
        match app-id="^com\\.mitchellh\\.ghostty$"
        open-on-workspace "2"
    }

    window-rule {
        match app-id="^com\\.anthropic\\.Claude$"
        match app-id="^grok-bot$"
        open-on-workspace "3"
    }

    window-rule {
        match app-id="^net\\.lutris\\.Lutris$"
        match app-id="^steam$"
        match app-id="(?i)vesktop|discord|whatsapp|wasistlos|telegram|signal"
        open-on-workspace "4"
    }

    window-rule {
        match app-id="(?i)^tradingview$"
        open-on-workspace "5"
    }

    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Float browser Picture-in-Picture windows.
    window-rule {
        match title="^Picture-in-Picture$"
        open-floating true
    }

    window-rule {
        match app-id="org.gnome.Calculator"
        open-floating true
    }

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }
